	Library.OnHover = function(self, Callback1, Callback2)
		Callback2 = Callback2 or function() end

		Library:Connect(self.Instance.MouseEnter, function()
			Callback1()
		end)

		Library:Connect(self.Instance.MouseLeave, function()
			Callback2()
		end)
