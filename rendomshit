		end)

		Items.Element:OnHover(Cfg.Hovering, Cfg.NoHover)

		ConfigFlags[Cfg.Flag] = Cfg.Set

		return setmetatable(Cfg, Library)
	end

	Library.InitConfigs = function(self)
		local Tab = self:AddTab({ Text = "Settings", Icon = "rbxassetid://99160812674479" })

		local Section = Tab:AddSection({
			Side = "Left",
			Title = "Configs",
		})

		local ConfigText
		local ConfigHolder = Section:AddDropdown({
			Text = "Configs",
			Flag = "ConfigList",
			Callback = function(option)
				if Text and option then
					Text.Set(option)
				end
			end,
		})

		Text = Section:AddInput({
			Text = "Config Name:",
			Flag = "config_Name_text",
			PlaceHolder = "Type config name here...",
			Callback = function(text)
				ConfigText = text
			end,
		})

		Section:AddButton({
			Text = "Save",
			Callback = function()
				if not ConfigText then
					return
				end

				Library:SaveConfig(ConfigText)
				ConfigHolder:UpdateConfigList()
			end,
		})

		Section:AddButton({
			Text = "Load",
			Callback = function()
				if not ConfigText then
					return
				end

				self.Tweening = true
				Library:LoadConfig(readfile(Library.Directory .. "/configs/" .. ConfigText .. ".cfg"))
				self.Tweening = false
				ConfigHolder:UpdateConfigList()
			end,
		})

		Section:AddButton({
			Text = "Delete",
			Callback = function()
				if not ConfigText then
					return
				end

				Library:DeleteConfig(ConfigText)
				ConfigHolder:UpdateConfigList()
			end,
		})

		Section:AddButton({
			Text = "Refresh",
			Callback = function()
				ConfigHolder:UpdateConfigList()
			end,
		})

		local Section = Tab:AddSection({
			Side = "Right",
			Title = "Other",
		})

		Section:AddColorPicker({
			Text = "Accent",
			Default = Themes.Preset.Accent,
			Transparency = 0,
			Flag = "Cock",
			Callback = function(Value, Alpha)
				Library:Refresh("Accent", Value)
				Themes.Preset.Accent = Value
				Library.TitleGradient.Instance.Color = ColorSequence.new({
					ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
					ColorSequenceKeypoint.new(1, Value),
				})
				cheat_theme = Value
			end,
		})

		Section:AddKeyPicker({
			Text = "Menu bind",
			Mode = "Toggle",
			ShowInList = false,
			Callback = function(Value)
				self.SetVisible(Value)
			end,
		})

		Section:AddSlider({
			Text = "Menu Transparency",
			Min = 0,
			Max = 1,
			Rounding = 0.01,
			Default = 0.04,
			Suffix = "%",
			Callback = function(int)
				self.Items.Menu.Instance.BackgroundTransparency = int
			end,
		})

		Section:AddSlider({
			Text = "Element Transparency",
			Min = 0,
			Max = 1,
			Rounding = 0.01,
			Default = 0.1,
			Suffix = "%",
			Callback = function(int)
				local Indexes = { "Black", "1", "2", "3" }

				for Index, Value in Indexes do
					for _, Element in Themes.Utility[Value].BackgroundColor3 do
						if Element == self.Items.Menu.Instance then
							continue
						end

						Element.BackgroundTransparency = int
					end
				end
			end,
		})

		Section:AddButton({
			Text = "Join discord",
			Callback = function()
				local rpc_url = "http://127.0.0.1:6463/rpc?v=1"
				local client_id = "1335721732711121028"
				local invite_code = discord_invite
				local request_data = {
					cmd = "INVITE_BROWSER",
					args = { code = invite_code },
					nonce = http_service:GenerateGUID(false),
					client_id = client_id,
				}
				pcall(function()
					local response = request({
						Url = rpc_url,
						Method = "POST",
						Headers = {
							["Content-Type"] = "application/json",
							["Origin"] = "https://discord.com",
						},
						Body = http_service:JSONEncode(request_data),
					})
				end)
			end,
		})

		ConfigHolder:UpdateConfigList()
	end
end

