				Active = false,
				Selectable = false,
				ZIndex = 2,
				Size = UDim2.new(1, 0, 1, 0),
				TextColor3 = Color3.fromRGB(194, 196, 202),
				Text = "Text",
				PlaceholderText = Cfg.PlaceHolder,
				Parent = Items.TextBoxHolder.Instance,
